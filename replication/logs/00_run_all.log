. * Group-specific slopes are obtained from explicit interaction Probit models.
. capture program drop store_slope

. program define store_slope
  1.     syntax, MODEL(name) EXPRESSION(string) NAME(name) CONDITION(string) TESTP(real)
  2.     quietly estimates restore `model'
  3.     local n=e(N)
  4.     local r2=e(r2_p)
  5.     quietly count if e(sample) & (`condition')
  6.     local gn=r(N)
  7.     quietly nlcom (Gift: `expression'), post
  8.     local p_text ""
  9.     if !missing(`testp') {
 10.         if `testp' < 0.0001 local p_text "<0.0001"
 11.         else local p_text = strtrim(string(`testp', "%9.4f"))
 12.     }
 13.     estadd scalar Observations=`n'
 14.     estadd scalar GroupN=`gn'
 15.     estadd scalar PseudoR2=`r2'
 16.     estadd local InteractionPText "`p_text'"
 17.     estadd local Controls "Yes"
 18.     estadd local ProvinceFE "Yes"
 19.     estadd local YearFE "Yes"
 20.     estimates store `name'
 21. end

. 
